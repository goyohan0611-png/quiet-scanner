{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiet Scanner",
  "version": "4.0.1",
  "identifier": "com.lab241.quietscanner",
  "build": { "frontendDist": "../electron/renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Quiet Scanner",
      "width": 1400, "height": 900, "minWidth": 1120, "minHeight": 680,
      "backgroundColor": "#f7f9fc"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../electron/renderer/IPFixStudio.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../docs/third-party.md": "THIRD-PARTY.md",
      "../LICENSES/": "LICENSES/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine", "languages": ["Korean", "English"],
        "installerHooks": "windows/prerequisites.nsh"
      },
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    }
  }
}
