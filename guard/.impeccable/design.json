      "css": ".ds-icon{width:18px;height:18px;flex-shrink:0;stroke:currentColor;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round;vertical-align:middle}.ds-nav{display:flex;flex-direction:column;gap:5px;max-width:172px}.ds-nav-item{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;min-height:42px;border:0;border-radius:8px;padding:11px 13px;text-align:left;display:flex;gap:11px;align-items:center;color:#52617a;background:transparent;font-size:13px;font-weight:570;cursor:pointer;transition:background .16s ease,color .16s ease}.ds-nav-item:hover{background:#f0f3f8;color:#18253b}.ds-nav-item[aria-current=page]{background:#edf3ff;color:#2058c7}.ds-nav-item:focus-visible{outline:3px solid #8aaffc;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
    {
      "name": "Review State Badge",
      "kind": "chip",
      "refersTo": "state-warning",
      "description": "Informational state; wording and dot communicate the state together.",
      "html": "<span class=\"ds-state\"><i class=\"ds-dot\"></i>공개 범위 검토</span>",
      "css": ".ds-state{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:inline-flex;gap:6px;align-items:center;font-size:12px;font-weight:600;white-space:nowrap;padding:5px 8px;border-radius:6px;background:#fff4da;color:#885600;line-height:1.3}.ds-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}"
    },
    {
      "name": "Working Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat bordered container with a shared inset and section title.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2 class=\"ds-panel-title\">보호 기능</h2><p class=\"ds-panel-description\">켜짐 여부와 실제 동작 확인을 구분해서 표시해요.</p></div></section>",
      "css": ".ds-panel{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;border:1px solid var(--line,#e5eaf1);border-radius:12px;background:var(--surface,#fff);overflow:hidden;color:#18253b}.ds-panel-heading{padding:21px 24px 17px}.ds-panel-title{margin:0;letter-spacing:-.025em;font-size:16px;font-weight:680}.ds-panel-description{font-size:12px;margin:4px 0 0;line-height:1.6;color:var(--muted,#52617a)}"
    },
    {
      "name": "Service Ledger Row",
      "kind": "custom",
      "description": "Aligned identity, evidence, state and management action; actions wrap below identity on narrow screens.",
      "html": "<div class=\"ds-service\"><span class=\"ds-service-symbol\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14.5 3.5a6 6 0 1 1-5.8 7.5L3 16.5V21h4v-3h3v-3l1.4-1.4 M16.5 7.5h.01\"/></svg></span><div class=\"ds-service-info\"><strong>SSH 접속 보호</strong><p>SSH 포트의 탐지·차단을 확인했어요.</p></div><span class=\"ds-state ds-state-good\"><i class=\"ds-dot\"></i>동작 확인</span><div class=\"ds-service-actions\"><button class=\"ds-button-quiet\" type=\"button\">관리</button></div></div>",
      "css": ".ds-icon{width:18px;height:18px;flex-shrink:0;stroke:currentColor;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round;vertical-align:middle}.ds-state{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:inline-flex;gap:6px;align-items:center;font-size:12px;font-weight:600;white-space:nowrap;padding:5px 8px;border-radius:6px;background:#fff4da;color:#885600;line-height:1.3}.ds-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}.ds-button-quiet{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;min-height:36px;padding:8px 13px;border-radius:var(--radius,8px);border:1px solid #d8e1ee;background:#fff;color:#34455f;font-size:13px;font-weight:580;line-height:1.35;cursor:pointer;transition:background .16s ease,color .16s ease,border-color .16s ease;background:transparent}.ds-button-quiet:hover{background:#f3f6fb;border-color:#b9c9e0}.ds-button-quiet:focus-visible{outline:3px solid #8aaffc;outline-offset:3px}.ds-service{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:grid;grid-template-columns:36px minmax(170px,1fr) auto auto;align-items:center;gap:16px;padding:20px 24px;border-top:1px solid #edf0f5;background:#fff;color:#18253b;min-height:86px}.ds-service-symbol{width:34px;height:34px;border-radius:9px;background:#f2f5fa;color:#597195;display:grid;place-items:center}.ds-service-info strong{font-size:14px;font-weight:640}.ds-service-info p{font-size:12px;margin:5px 0 0;line-height:1.5;color:#52617a}.ds-service-actions{display:flex;justify-content:flex-end;min-width:105px}.ds-state-good{color:#08734f;background:#eaf8f1}@media(max-width:760px){.ds-service{grid-template-columns:29px minmax(0,1fr) auto;padding:18px;gap:9px 11px}.ds-service-actions{grid-column:2/4;justify-content:flex-start;min-width:0;padding-top:2px}.ds-service-info strong{font-size:13px}.ds-service-info p{word-break:keep-all;overflow-wrap:anywhere}.ds-service-symbol{width:29px;height:30px;border-radius:7px}}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:none}}"
    },
    {
      "name": "Exposure Evidence Table",
      "kind": "custom",
      "description": "Readable evidence rows with understated rules and focusable local horizontal scrolling.",
      "html": "<div class=\"ds-table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"포트와 실행 프로그램 표, 가로로 이동할 수 있음\"><table class=\"ds-table\"><thead><tr><th scope=\"col\">주소 · 포트</th><th scope=\"col\">프로토콜</th><th scope=\"col\">실행 프로그램</th><th scope=\"col\">접속 범위</th><th scope=\"col\">확인 사항</th></tr></thead><tbody><tr><td>0.0.0.0:5432</td><td>TCP</td><td>postgres</td><td>모든 인터페이스</td><td>공개 범위 검토</td></tr></tbody></table></div>",
      "css": ".ds-table-scroll{overflow:auto;border-top:1px solid var(--line,#e5eaf1);scrollbar-color:#c1ccdb #f7f9fc;scrollbar-width:thin}.ds-table-scroll:focus-visible{outline:2px solid #2563eb;outline-offset:-2px}.ds-table{font-family:SUIT,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;width:100%;border-collapse:collapse;white-space:nowrap;text-align:left;font-size:12px;background:#fff}.ds-table th{background:#f8fafd;color:#65748c;font-size:12px;font-weight:570;padding:12px 19px;border-bottom:1px solid var(--line,#e5eaf1)}.ds-table td{padding:14px 19px;border-bottom:1px solid #edf0f5;font-variant-numeric:tabular-nums;color:#40516b}.ds-table th:first-child,.ds-table td:first-child{padding-left:24px}.ds-table tbody tr:last-child td{border-bottom:0}.ds-table tbody tr:hover{background:#fafcfe}@media(max-width:760px){.ds-table{min-width:630px}.ds-table th:first-child,.ds-table td:first-child{padding-left:18px}}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Operating Ledger",
    "overview": "Quiet Guard uses restrained blue, white working surfaces and compact Korean labels to make a server's condition readable. Its operating-handover structure presents current condition before outstanding work. Repeated service rows keep service identity, evidence, status and action aligned, while diagnostic detail stays folded until requested.\n\nThis is a code-led record of the implemented Operate surface, not a claim of user-approved brand language. The Quiet family commitments are clear Korean labels, restrained blue accents and compact operational screens. The preliminary direction considered a service timetable, audit note, editorial daily brief, emergency contact sheet, operations handover, library ledger and inspection checklist; operations handover was the assigned fifth direction (seed reference: `seed:ef34ddc9d4fa4098`). Its challenger studies contributed evidence separation, stable alignment and a small semantic legend, without adopting their decorative motifs.",
    "keyCharacteristics": [
      "Calm, compact rows with exact service names and visible actions.",
      "Independent protection and risk summaries; evidence determines state.",
      "Flat white surfaces, light rules and restrained semantic color.",
      "Self-hosted Korean typography and authored SVG icons."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Green follows verified evidence or successful work. Unknown, disconnected and stale conditions use neutral or amber state treatments with explicit text.",
        "section": "colors"
      },
      {
        "name": "The Readable Detail Rule",
        "body": "Use the label/detail step for compact functional text. Counts, addresses, timestamps and table values use tabular numerals where the source establishes them.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Keep working panels flat; reserve the implemented shadow vocabulary for temporary foreground feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use semantic color together with explicit state wording and evidence scope.",
      "**Do** preserve aligned service rows, compact controls and readable functional detail.",
      "**Do** use self-hosted SUIT and inline outline SVGs for the working interface.",
      "**Do** keep wide data locally scrollable and expose its scroll cue on narrow screens.",
      "**Do** retain visible keyboard focus and respect reduced-motion preferences."
    ],
    "donts": [
      "**Don't** let an unknown, stale or disconnected condition retain a green live indicator.",
      "**Don't** imply complete protection from enabled software or local binding evidence.",
      "**Don't** add decorative shadows to the flat working panels.",
      "**Don't** load third-party fonts or analytics into the management surface."
    ]
  }
}
