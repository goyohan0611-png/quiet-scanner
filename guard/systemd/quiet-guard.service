# Managed by Quiet Guard foundation v1
[Unit]
Description=Quiet Guard foundation agent (protection not connected yet)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/lib/quiet-guard/quiet-guard agent
DynamicUser=yes
RuntimeDirectory=quiet-guard
RuntimeDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
